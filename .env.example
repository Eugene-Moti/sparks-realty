# Copy to .env.local (never commit .env.local) and mirror these in Vercel → Settings → Environment Variables.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://skuohnayzhpeyrnkwknp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never import into client components.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, no trailing slash. Local: http://localhost:3000
# Vercel: https://<project>.vercel.app until a custom domain is added.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: email alerts for new enquiries (resend.com, free tier). Without a key, alerts are skipped.
RESEND_API_KEY=
# Optional: verified sender, e.g. "Sparks Properties Website <alerts@yourdomain>". Default: Resend's test sender,
# which only delivers to your own Resend account email until you verify a domain.
RESEND_FROM=
# Optional: where alerts go. Default: the email in Admin → Settings.
ENQUIRY_ALERT_EMAIL=
# Optional: Google Analytics 4 (e.g. G-XXXXXXXXXX). Loads ONLY after a visitor accepts analytics cookies.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Optional: MapLibre with MapTiler tiles
NEXT_PUBLIC_MAPTILER_KEY=
